              "steps": [
                {
                  "fr": "Formuler une question PICO ou PECO non clinique a partir du scenario fourni.",
                  "en": "Formuler une question PICO ou PECO non clinique a partir du scenario fourni."
                },
                {
                  "fr": "Pre-specifier cinq criteres d'inclusion ou d'exclusion.",
                  "en": "Pre-specifier cinq criteres d'inclusion ou d'exclusion."
                },
                {
                  "fr": "Trier les 36 notices synthetiques et documenter les cas incertains.",
                  "en": "Trier les 36 notices synthetiques et documenter les cas incertains."
                },
                {
                  "fr": "Completer la matrice source-affirmation avec uniquement des identifiants fournis.",
                  "en": "Complete the source-claim matrix using only the provided identifiers."
                },
